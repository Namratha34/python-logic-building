questions = [
    ["What is the capital of India?", "Mumbai", "Delhi", "Kolkata", "Chennai", 2],
    ["Which planet is known as the Red Planet?", "Earth", "Venus", "Mars", "Jupiter", 3],
    ["Who is known as the Father of the Nation?", "Jawaharlal Nehru", "Bhagat Singh", "Mahatma Gandhi", "Subhash Chandra Bose", 3],
    ["Which is the largest ocean?", "Atlantic", "Indian", "Pacific", "Arctic", 3],
    ["Which language is known as the language of the web?", "Python", "Java", "JavaScript", "C++", 3]
]

money = 0

for i in range(len(questions)):
    print(f"\nQuestion {i+1}")
    print(questions[i][0])
    print("1.", questions[i][1])
    print("2.", questions[i][2])
    print("3.", questions[i][3])
    print("4.", questions[i][4])

    user = int(input("Enter your choice (1-4): "))

    if user == questions[i][5]:
        money += 1000
        print("✅ Correct Answer!")
        print("Prize Money:", money)
    else:
        print("❌ Wrong Answer!")
        print("Game Over")
        break

print("\nTotal Prize Money Won:", money)

